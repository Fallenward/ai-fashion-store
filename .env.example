# Copy to .env and replace placeholders. Never commit the real .env file.

APP_ENV=development
APP_NAME=Atelier
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Used when you run the API on your machine. Docker Compose replaces this with the db service.
DATABASE_URL=postgresql+psycopg://fashion:fashion@127.0.0.1:5432/fashion

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
PUBLIC_APP_URL=http://localhost:5173

# gemini or ollama. The API still starts when this is unset or the key is empty.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# local works without a key. Use gemini or ollama for real semantic search.
EMBEDDING_PROVIDER=local
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Leave Stripe empty to use the labeled development mock checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

SHIPPING_FLAT=8.00
FREE_SHIPPING_OVER=150.00
RATE_LIMIT_ENABLED=true
